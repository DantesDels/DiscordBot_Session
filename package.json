{
  "name": "discordbot-session",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Serverless Discord bot for game session management (Cloudflare Workers, HTTP Interactions)",
  "scripts": {
    "dev": "wrangler dev --config config/wrangler.toml",
    "deploy": "wrangler deploy --config config/wrangler.toml",
    "typecheck": "tsc -p config/tsconfig.json",
    "test": "vitest run",
    "register": "node register.js",
    "catalog:sync": "node sync-catalog.js"
  },
  "dependencies": {
    "discord-interactions": "^4.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261109.1",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5",
    "wrangler": "^4.0.0"
  }
}
